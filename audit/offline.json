{
  "note": "Every cell executed for real on the host. Tiers are what an unprivileged agent framework ships, not a container.",
  "tiers": [
    {
      "key": "t0_naked",
      "provides": "nothing"
    },
    {
      "key": "t1_cwd",
      "provides": "cwd"
    },
    {
      "key": "t2_env",
      "provides": "cwd, env"
    },
    {
      "key": "t3_rlimits",
      "provides": "cwd, env, rlimits"
    },
    {
      "key": "t4_full",
      "provides": "cwd, env, rlimits, close_fds, new_session"
    }
  ],
  "probes": [
    {
      "key": "fs_absolute_read",
      "what": "read a host file by absolute path",
      "family": "filesystem",
      "note": "cwd scopes where relative paths resolve, nothing more"
    },
    {
      "key": "fs_traversal",
      "what": "climb out of the sandbox with ../",
      "family": "filesystem",
      "note": "the path is never resolved against a jail because there is none"
    },
    {
      "key": "secret_env",
      "what": "read a secret left in the environment",
      "family": "secrets",
      "note": "the one thing an env scrub is actually for"
    },
    {
      "key": "secret_proc_environ",
      "what": "read the parent's env via /proc",
      "family": "secrets",
      "note": "scrubbing the child's env does not hide the parent's"
    },
    {
      "key": "net_loopback",
      "what": "open a network connection",
      "family": "network",
      "note": "no tier here filters egress; a real deny needs namespaces"
    },
    {
      "key": "proc_grandchild",
      "what": "leave a process running after cleanup",
      "family": "process",
      "note": "setsid defeats killpg at every tier; only a PID namespace reaps it"
    },
    {
      "key": "fd_leak",
      "what": "read a descriptor the parent leaked",
      "family": "process",
      "note": "no path, no permission, just an inherited number"
    },
    {
      "key": "res_oversized_write",
      "what": "write a file past the size limit",
      "family": "resource",
      "note": "RLIMIT_FSIZE is per-process and portable, unlike NPROC"
    }
  ],
